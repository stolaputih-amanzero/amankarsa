# ==========================================
# SUPABASE CONFIGURATION (NEXT.JS)
# ==========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ==========================================
# SACRED VAULT (SERVER-SIDE ONLY)
# ==========================================
# Generate a strong 32+ char random string for production.
# NEVER COMMIT THE REAL KEY TO GITHUB.
BILIK_DOA_ENCRYPTION_KEY=your-32-char-encryption-key-for-bilik-doa

# ==========================================
# PILOT SAFETY NET (FEATURE FLAGS)
# ==========================================
# Set to 'false' to gracefully disable a feature via UI without redeploying
NEXT_PUBLIC_FEATURE_SAKU=true
NEXT_PUBLIC_FEATURE_BILIK_DOA=true
NEXT_PUBLIC_FEATURE_POHON_KARSA=true
NEXT_PUBLIC_FEATURE_IMPACT=true
